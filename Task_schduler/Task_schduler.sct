; Keep the scatter path relative: Arm Compiler 5 treats apostrophes in an
; absolute path as quote characters, and this project lives under d'h'm.

LR_IROM1 0x08000000 0x00080000 {
    ER_IROM1 0x08000000 0x00080000 {
        *.o (RESET, +First)
        *(InRoot$$Sections)
        .ANY (+RO)
        .ANY (+XO)
    }
    RW_IRAM1 0x20000000 0x00030000 {
        .ANY (+RW +ZI)
    }
}
